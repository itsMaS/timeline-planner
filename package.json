{
  "name": "timeline-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:api": "esbuild supabase/functions/api-query/src.ts --bundle --platform=neutral --format=esm --target=es2022 --minify --define:process.env.NODE_ENV='\"production\"' --outfile=supabase/functions/api-query/index.ts --log-level=warning",
    "build:skill": "esbuild agent/timeline.ts --bundle --platform=node --target=node20 --format=cjs --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --external:playwright-core --outfile=plugins/timeline-agent/skills/timeline-agent/scripts/timeline.cjs --log-level=warning"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
